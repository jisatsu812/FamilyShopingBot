# Скопируй в .env и заполни. Сам .env в git не попадает.

BOT_TOKEN=
ADMIN_ID=

# Адрес, который открывается по кнопке в боте (локально — ссылка ngrok, на Render — адрес сервиса)
WEBAPP_URL=https://твоя-ссылка.ngrok-free.dev

# Только для локальной разработки: 0 = можно открывать мини-апп в обычном браузере.
# На Render эту переменную НЕ задавай (по умолчанию включена строгая проверка Telegram).
STRICT_AUTH=0

# Необязательно:
# WEBHOOK_URL=https://familyshopingbot.onrender.com   (на Render подхватывается само; локально оставь пустым — будет polling)
# SHOPPING_DB_PATH=/data/shopping.db                  (путь к БД, например на persistent disk)
# ADMIN_USERNAME=tune430hz
